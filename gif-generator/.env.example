# Copy to .env.local and fill in. Without a token the app runs in demo mode:
# Image/Text → GIF make a local (non-AI) preview animation and
# GIF → Character is disabled.

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: override the Replicate model ("owner/name") used for each step.
# REPLICATE_TEXT_MODEL=wan-video/wan-2.2-t2v-fast
# REPLICATE_IMAGE_MODEL=wan-video/wan-2.2-i2v-fast
# REPLICATE_KEYFRAME_MODEL=google/nano-banana
# REPLICATE_SWAP_MODEL=wan-video/wan-2.2-animate-replace
# REPLICATE_MOVE_MODEL=wan-video/wan-2.2-animate-animation

# Optional: extra JSON inputs, e.g. {"resolution":"480p"}
# REPLICATE_EXTRA_INPUT=           # text/image → video models
# REPLICATE_KEYFRAME_EXTRA_INPUT=  # character keyframe model
# REPLICATE_SWAP_EXTRA_INPUT=      # GIF → Character models

# Optional: public share links. Connect a Vercel Blob store (sets this for you).
# BLOB_READ_WRITE_TOKEN=

# Optional: use a system FFmpeg instead of the bundled ffmpeg-static binary.
# FFMPEG_PATH=/usr/bin/ffmpeg
