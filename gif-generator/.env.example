# Copy to .env.local and fill in. Without a token the app runs in demo mode
# (GIFs are made locally from your photo or a procedural animation).

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: any Replicate text-to-video / image-to-video model ("owner/name").
# REPLICATE_TEXT_MODEL=wan-video/wan-2.2-t2v-fast
# REPLICATE_IMAGE_MODEL=wan-video/wan-2.2-i2v-fast

# Optional: extra JSON inputs passed to the model, e.g. {"resolution":"480p"}
# REPLICATE_EXTRA_INPUT=

# Optional: use a system FFmpeg instead of the bundled ffmpeg-static binary.
# FFMPEG_PATH=/usr/bin/ffmpeg
